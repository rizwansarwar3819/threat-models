                  "new": false,
                  "number": 1,
                  "score": ""
                },
                {
                  "id": "f6339b99-7715-4d91-bf6b-11e2c6438b0c",
                  "title": "Brute Force Login Attack",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Denial of service",
                  "description": "An attacker repeatedly sends login requests to exhaust server resources or lock out legitimate users, effectively denying access to the service.",
                  "mitigation": "Implement rate limiting on the login endpoint, use CAPTCHA after multiple failures, and set account lockout thresholds with admin alerting.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
